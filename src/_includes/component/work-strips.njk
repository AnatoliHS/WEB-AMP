{#- Case study strips, built from the case studies collection. The current page is left out. -#}
<!-- Desktop: expanding strips (hover widens one). Phones: asymmetric mosaic. Script in scripts.njk -->
<div class="work-strips" data-work-strips>
  {%- for cs in collections.caseStudies | excludeUrl(page.url) %}
  <a href="{{ cs.url }}" class="work-strip{% if loop.first %} is-active{% endif %}">
    <div class="work-strip-media">
      <img src="{{ (cs.data.card_image or cs.data.hero_image) | e }}" alt="{{ (cs.data.card_alt or cs.data.hero_alt) | e }}" loading="lazy">
    </div>
    <div class="work-strip-row">
      <h3 class="work-strip-title">{{ (cs.data.card_title or cs.data.client) | e }}</h3>
      <span class="work-strip-arrow"><svg width="14" height="12" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d="M 0 6 L 0 8 L 12 8 L 12 10 L 14 10 L 14 8 L 16 8 L 16 6 L 14 6 L 14 4 L 12 4 L 12 6 Z M 10 2 L 12 2 L 12 4 L 10 4 Z M 10 2 L 8 2 L 8 0 L 10 0 Z M 10 12 L 12 12 L 12 10 L 10 10 Z M 10 12 L 8 12 L 8 14 L 10 14 Z"/></svg></span>
    </div>
  </a>
  {%- endfor %}
</div>
