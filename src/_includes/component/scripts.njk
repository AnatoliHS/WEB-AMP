<script>
  // Mobile / Drawer Menu
  const menuToggle = document.getElementById('menuToggle');
  const menuClose = document.getElementById('menuClose');
  const menuDrawer = document.getElementById('menuDrawer');

  function openMenu() {
    if (menuDrawer) {
      menuDrawer.classList.add('is-open');
      menuDrawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenu() {
    if (menuDrawer) {
      menuDrawer.classList.remove('is-open');
      menuDrawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  if (menuToggle) menuToggle.addEventListener('click', openMenu);
  if (menuClose) menuClose.addEventListener('click', closeMenu);

  // Close menu on pressing Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuDrawer && menuDrawer.classList.contains('is-open')) {
      closeMenu();
    }
  });

  // Close menu when clicking navigation link
  const drawerLinks = document.querySelectorAll('.menu-nav-links a');
  drawerLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // FAQ Accordion
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const questionBtn = item.querySelector('.faq-question');
    const answerBox = item.querySelector('.faq-answer');

    function toggleFaq() {
      const isOpen = item.classList.contains('is-open');
      // Close all others
      faqItems.forEach(i => {
        i.classList.remove('is-open');
        const btn = i.querySelector('.faq-question');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
      // Toggle current
      if (!isOpen) {
        item.classList.add('is-open');
        if (questionBtn) questionBtn.setAttribute('aria-expanded', 'true');
      }
    }

    if (questionBtn) questionBtn.addEventListener('click', toggleFaq);
    if (answerBox) answerBox.addEventListener('click', toggleFaq);
  });

  // Deck Waitlist Card Toggle
  function toggleDeckWaitlist() {
    const card = document.getElementById('deckWaitlist');
    const btn = document.getElementById('btnToggleDeckWaitlist');
    if (!card) return;
    const isOpen = card.classList.contains('is-open');
    if (isOpen) {
      card.classList.remove('is-open');
      card.setAttribute('aria-hidden', 'true');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    } else {
      card.classList.add('is-open');
      card.setAttribute('aria-hidden', 'false');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
  window.toggleDeckWaitlist = toggleDeckWaitlist;

  // Header Scroll Effect
  const header = document.querySelector('.site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  });
</script>