<!-- Page transition overlay: plays card-fan / card-spread between pages (logic in scripts.njk) -->
<div class="page-transition" aria-hidden="true">
  <video class="page-transition-video" data-clip="fan" muted playsinline preload="none" src="/images/card-fan.mp4"></video>
  <video class="page-transition-video" data-clip="spread" muted playsinline preload="none" src="/images/card-spread.mp4"></video>
  <img class="page-transition-logo" src="/images/amp-logo-256.png" alt="" width="256" height="256" decoding="async">
</div>
